source("rv/scripts/rvr.R")
source("rv/scripts/activate.R")

# A project-local .Rprofile suppresses the user-level ~/.Rprofile (which may
# set up editor integration such as VS Code's .vsc.attach()). Re-source it so
# the editor integration keeps working.
if (file.exists("~/.Rprofile")) source("~/.Rprofile")
